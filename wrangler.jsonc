{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "putokart",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // link público putokart.<cuenta>.workers.dev
  "workers_dev": true,
  // el cliente (Three.js + Rapier) se empaqueta en public/juego.js antes de desplegar
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }]
}
